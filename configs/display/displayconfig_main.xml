            <point><first>5000</first>  <second>0.678</second></point>
            <point><first>10000</first> <second>1.0</second></point>
          </map>
        </luxToBrightnessMapping>
        <idleStylusTimeoutMillis>10000</idleStylusTimeoutMillis>
    </autoBrightness>

