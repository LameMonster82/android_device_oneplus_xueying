[EquivalentFocalLengthIn35mmSAT]
    #The equivalent focal length value of each sensor corresponding to the light change point is as follows:
    #Product requirements modify the equivalent focal lengths of the main camera and telephoto to 24mm and 70mm
    #camera     focalLength         focalLenthIn35mm            factor
    #ultra wide     2.59                14(14.008)              5.41
    #wide           6.06                23(22.391)->24(24.05)   3.69->3.97
    #tele           13.3                71(70.886)->70(70.09)   5.33->5.27
    #front          2.15                20(20.449)              9.51
    #front_sub      2.87                22(21.741)              7.58
    #A linear function is uniquely determined by the coordinates of one or two points,
    #and then the equivalent focal length of each zoom position is calculated according to the function
    #                  zoom_min     zoom_max    point1.x   point1.y    point2.x    point2.y
    Range[0]       =    0.6;           1.0;       0.6;        14;          1.0;        24;
    Range[1]       =    1.0;           3.0;       1.0;        24;          3.0;        70;
    Range[2]       =    3.0;         120.1;       0.6;        14;          3.0;        70;

[EquivalentFocalLengthIn35mmNonSAT]
    #                  operation_mode    cameraid   point1.x   point1.y    point2.x    point2.y
    Mode[0]        =      0x8009;           3;        1.0;        14;         1.7;        24;     #professional mode uw
    Mode[1]        =      0x8009;           0;        1.0;        24;         3.0;        70;     #professional mode w
    Mode[2]        =      0x8009;           4;        1.0;        70;           0;         0;     #professional mode tele
    Mode[3]        =      0x8011;          -1;        1.0;        24;           0;         0;     #full portrait mode
    Mode[4]        =      0x8010;          -1;        3.0;        70;           0;         0;     #half portrait mode
    Mode[5]        =      0x80ac;           3;        1.0;        14;         1.7;        24;     #xpan mode uw
    Mode[6]        =      0x80ac;           0;        1.0;        24;         3.0;        70;     #xpan mode w
    Mode[7]        =      0x80ac;           4;        1.0;        70;           0;         0;     #xpan mode tele
    Mode[8]        =          -1;           3;        1.0;        14;           0;         0;     #non-sat mode uw
    Mode[9]        =          -1;           0;        1.0;        24;           0;         0;     #non-sat mode w
    Mode[10]       =          -1;           4;        1.0;        70;           0;         0;     #non-sat mode tele
    Mode[11]       =          -1;           1;        1.0;        20;           0;         0;     #non-sat mode front
    Mode[12]       =          -1;           5;        1.0;        22;           0;         0;     #non-sat mode front-sub
    Mode[13]       =      0x8030;          -1;        1.0;        24;         2.0;        47;     #2X portrait mode

